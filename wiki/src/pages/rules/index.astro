---
import Layout from '../../components/Layout.astro';
import { RULES } from '../../lib/glossary';
import { wtContent } from '../../lib/i18n';
import { wr } from '../../lib/loc';

// The Special Rules and Weapon Abilities tabs are GENERATED from the glossary (the same text the glossary pages and the app show, which
// matches Core Rules 1.45 rule by rule), in the order the Core Rules print them. They used to be typed by hand and had drifted
// (Armorbane "+3" instead of "+x", "Armor Piercing" for Piercing, no Advisor, Sniper, Charge or Hover Mode).
const SPECIAL_KEYS = ["ward","open","objective secured!","vanguard","deep strike","stealth","terrifying","swarm","berserk","aegis","blank","acute senses","advisor","anti-grav","blind rage","bodyguard","brotherhood of psykers","combat squads","command squad","counter-attack","deflect","daemon","daemonic instability","fast","fearless","favored enemy","frenzy","furious charge","greater daemon","haste","hit & run","hunter","infiltrator","massive","mindless","move through cover","narthecium","outflank","parry","regeneration","retribution","squadron","tank hunter","use cover","unique","unyielding","warded"]
  .sort((a, b) => RULES[a].name.localeCompare(RULES[b].name));
const WEAPON_KEYS = ["ammo","anti-air","armorbane","at","auto hit","beam","blast","blind","blood drinker","bomb","charge","combi","deadly","decimate","deflagrate","extra attack","force weapon","grav","graviton","gruesome","haywire","hover mode","indirect","life curse","limit","master-crafted","melta","monofilament","overheating","piercing","poison","precision","psi-shock","quick","rad","rending","seeking","shield breaker","shred","slow","sniper","soul burn","sunder","suppression","unwieldy"];
const ruleName = (k: string) => wr(RULES[k].name.replace('({X})', ' (X)').replace('{X}', 'X'));
// Rules whose parameter is a roll ("Rending(5+)"): the Core Rules print it "x+", the glossary keeps only the placeholder.
const ROLL_PARAM = new Set(['ward', 'aegis', 'berserk', 'deadly', 'rending', 'soul burn', 'deflagrate', 'precision', 'poison', 'piercing']);
const ruleText = (k: string) => wtContent('glossary', k, RULES[k].description).replace(/\{X\}/g, ROLL_PARAM.has(k) ? 'X+' : 'X');
---
<Layout title="Core Rules — Custom40k Wiki">

<div class="rules-page">

  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <div class="rules-hero">
    <div class="rules-hero-bg" aria-hidden="true"></div>
    <div class="rules-hero-content">
      <div class="rules-seal" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="68" height="68" fill="none">
          <circle cx="32" cy="32" r="30" stroke="#a21217" stroke-width="1.2" fill="rgba(162,18,23,0.06)"/>
          <circle cx="32" cy="32" r="22" stroke="#a21217" stroke-width="0.8" fill="none" stroke-dasharray="3,2"/>
          <polygon points="32,8 35,22 50,22 38,30 42,44 32,36 22,44 26,30 14,22 29,22" fill="rgba(162,18,23,0.15)" stroke="#a21217" stroke-width="1"/>
          <circle cx="32" cy="32" r="5" fill="#a21217" opacity="0.7"/>
        </svg>
      </div>
      <p class="rules-supertitle">Custom40k Reference</p>
      <h1 class="rules-title">Core Rules</h1>
      <p class="rules-meta">v1.45 · Balance 5.05 · FAQ #5: Codex rules override Core Rules</p>
    </div>
  </div>

  <!-- ── Tab Nav ────────────────────────────────────────────────── -->
  <nav class="tab-bar" role="tablist" aria-label="Core Rules sections">
    <button class="tab-btn tab-active" data-tab="battle" role="tab">Battle Round</button>
    <button class="tab-btn" data-tab="combat" role="tab">Combat</button>
    <button class="tab-btn" data-tab="units" role="tab">Unit Types</button>
    <button class="tab-btn" data-tab="special" role="tab">Special Rules</button>
    <button class="tab-btn" data-tab="weapons" role="tab">Weapon Abilities</button>
    <button class="tab-btn" data-tab="army" role="tab">Army &amp; Allies</button>
    <button class="tab-btn" data-tab="psychic" role="tab">Psychic</button>
  </nav>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- TAB: BATTLE ROUND                                          -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <div id="tab-battle" class="tab-panel tab-panel--active">

    <div class="phase-grid">
      <div class="phase-card phase-card--1">
        <img src="/phase-icons/rally.svg" class="phase-icon" alt="" aria-hidden="true">
        <div class="phase-name">Rally Phase</div>
        <p>Take Leadership tests for units with Battleshock tokens (2D6 ≤ Ld to pass). Pass: remove all tokens. Fail: tokens remain. 2 tokens = Fleeing.</p>
        <div class="sub-rule">
          <strong>Battleshock Tokens</strong>
          <ul>
            <li><span class="badge-inline">1 token — Pinned</span> −1 to hit, movement halved. May only make a Disorderly Charge.</li>
            <li><span class="badge-inline badge-red">2 tokens — Fleeing</span> Move D6+6″ toward the nearest friendly board edge. Can't receive orders, counts as activated, can't hold or contest objectives and ignores difficult and dangerous terrain. Removed if reaching the board edge. If it enters melee again that round it can't fight and automatically loses; instead of fleeing again it stays in place with 1 token.</li>
          </ul>
        </div>
      </div>

      <div class="phase-card phase-card--2">
        <img src="/phase-icons/reinforce.svg" class="phase-icon" alt="" aria-hidden="true">
        <div class="phase-name">Reinforcement Phase</div>
        <p>You may roll reinforcement dice equal to the battle round number. Each 4+ must bring one unit from reserve, if possible. They enter from your board edge during their activation in the following Command phase, with an Advance or Move &amp; Shoot order only.</p>
        <table class="compact-table">
          <thead><tr><th>Round</th><th>Dice</th><th>Auto Units</th></tr></thead>
          <tbody>
            <tr><td>1</td><td>1D6</td><td>—</td></tr>
            <tr><td>2</td><td>2D6</td><td>—</td></tr>
            <tr><td>3</td><td>3D6</td><td>+1</td></tr>
            <tr><td>4</td><td>4D6</td><td>+2</td></tr>
            <tr><td>5</td><td>5D6</td><td>+3</td></tr>
          </tbody>
        </table>
        <p class="note">Transports + embarked units count as one reserve. Characters attached to a unit roll together.</p>
      </div>

      <div class="phase-card phase-card--3">
        <img src="/phase-icons/command.svg" class="phase-icon" alt="" aria-hidden="true">
        <div class="phase-name">Command Phase</div>
        <p>Both players assign orders face-down to all units simultaneously. Orders determine what a unit can do in the Action Phase. <strong>All allowed actions of an order must be resolved in the order they are written.</strong></p>
        <div class="order-grid">
          <div class="order-pill">Advance</div>
          <div class="order-pill">Charge</div>
          <div class="order-pill">Escape</div>
          <div class="order-pill">Fight</div>
          <div class="order-pill">Move &amp; Shoot</div>
          <div class="order-pill">Stand &amp; Shoot</div>
        </div>
        <p class="note">At the end of each Command Phase the player with fewer Orders gets 1 Skip token per 2 Orders of difference, rounded up (1–2 = 1 token, 3–4 = 2, 5–6 = 3). Unused Skip tokens expire at the end of the battle round.</p>
      </div>

      <div class="phase-card phase-card--4">
        <img src="/phase-icons/initiative.svg" class="phase-icon" alt="" aria-hidden="true">
        <div class="phase-name">Initiative Phase</div>
        <p>Both players roll 2D6. Higher result wins initiative and activates first in the Action Phase. Ties: player who did NOT have initiative last round wins. First round: whoever finished deploying first.</p>
      </div>

      <div class="phase-card phase-card--5">
        <img src="/phase-icons/action.svg" class="phase-icon" alt="" aria-hidden="true">
        <div class="phase-name">Action Phase</div>
        <p>Players alternate activating one unit at a time, starting with the initiative holder. Each unit carries out its assigned order.</p>
        <p class="note">A unit may move, shoot, and fight in the same round — but each action only once. A unit already activated may still fight if charged later.</p>
        <p class="note">Doing nothing: a unit does not need to perform every part of an order — a Move &amp; Shoot unit may skip either the move or the shooting. Passing: a player with no units left to activate passes, and the other keeps activating until every unit has acted.</p>
      </div>
    </div>

    <!-- Orders detail -->
    <div class="rule-section reveal">
      <div class="section-divider"><span>Orders</span></div>
      <div class="rule-grid">
        <div class="rule-card">
          <div class="rule-name">Advance</div>
          <p>Move up to M. May Advance D6″ extra. Declare any number of visible enemy units as ranged targets — they may answer with <em>Take Cover</em>. Shoot Assault/Pistol/Grenade at −1. Cast basic psychic powers.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Charge</div>
          <p>Move up to M (max 12″). Ranged targets may answer with <em>Take Cover</em>. Declare charge targets — they may answer with <em>Defensive Fire</em>, <em>Hold your Ground</em> or <em>Counter-Attack</em>. Make a 6″ Charge move to reach them. Gain +1 A or +1 I as Charge bonus. Then resolve Fight.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Escape</div>
          <p>Must be in melee. Receive 1 automatic hit per enemy model in range. Gain 2 Battleshock tokens and flee. The enemy does NOT pursue as normal: they stay locked in the melee if you still have units in base contact with them, and it resolves as if everyone had Fight. With nothing of yours left, they lose their order, count as activated and may only consolidate.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Fight</div>
          <p>Must be in melee. Resolve the melee combat. Removes orders from all units in the melee.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Move &amp; Shoot</div>
          <p>Move up to M. Ranged targets may answer with <em>Take Cover</em>. Fire any weapon except Heavy. Cast basic and normal psychic powers.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Stand &amp; Shoot</div>
          <p>Cannot move. Ranged targets may answer with <em>Take Cover</em>. Fire any weapon including Heavy. −1 to total hit penalty. Cast all psychic powers.</p>
        </div>
      </div>
    </div>

    <!-- Meta Orders -->
    <div class="rule-section reveal">
      <div class="section-divider"><span>Meta Orders (Defensive Reactions)</span></div>
      <p class="section-intro">Not assigned in the Command Phase — triggered. A Defensive Reaction may only be used by a unit that has not yet been activated this round, and using one removes that unit&rsquo;s order. None of them can be used by a unit engaged in melee.</p>
      <p class="section-note">Triggered in specific situations — not assigned in the Command Phase. Can only be used by units that haven't activated yet this round and are not in melee. If several units use Defensive Reactions, all declare them simultaneously.</p>
      <div class="rule-grid">
        <div class="rule-card">
          <div class="rule-name">Acute Senses</div>
          <p>Requires the Acute Senses ability, a unit that has not activated yet, and an enemy unit deployed from reserves within 12″: fire at it as if it had a Stand &amp; Shoot order. Resolves after the enemy is deployed and before it takes another action.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Counter-Attack</div>
          <p>Requires Counter-Attack ability. When declared as a charge target: treated as having executed a Charge order. Must pick Charge bonus before attacker does.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Defensive Fire</div>
          <p>When declared as a charge target: fire ranged weapons at the charger at −1 to hit. Attacker auto-passes Leadership during this.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Hold Your Ground</div>
          <p>When declared as a charge target: negates the attacker's Charge bonus. At least 50% of charged units must use this to negate the bonus.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Take Cover</div>
          <p>When declared as a ranged target: +1 to Saving throws vs ranged attacks and −1 AT (to a minimum of 0) until end of enemy activation.</p>
        </div>
      </div>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Unit Formation</span></div>
      <div class="rule-grid">
        <div class="rule-card">
          <div class="rule-name">In formation</div>
          <p>At the end of its movement a unit must be <strong>in formation</strong>: no model may be
             more than <strong>2&Prime; horizontally</strong> or <strong>5&Prime; vertically</strong>
             from another model in the same unit.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">In melee</div>
          <p>Units engaged in close combat do not need to maintain formation. After leaving melee,
             models must move to bring as many models as possible back into formation.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Enemy models</div>
          <p>Models must keep a minimum distance of <strong>1&Prime;</strong> from all enemy models.
             Creatures may move through friendly models; vehicles must be bypassed.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Mixed movement profiles</div>
          <p>A unit with models of different movement limits applies them to the whole unit. A character in Terminator armor joining an Infantry unit means the unit cannot Advance and cannot pursue in melee (Unyielding).</p>
        </div>
      </div>
      <div class="diagram-box">
        <img class="diagram-svg" src="/diagrams/unit-formation.svg" loading="lazy" decoding="async"
             alt="Unit formation: each model is within 2 inches of another model in the same unit, forming an unbroken chain; a model further away is out of formation." />
        <div class="diagram-legend"><span>Each model within <strong>2&Prime;</strong> of another in the same unit</span><span>The chain may not break</span></div>
      </div>
    </div>

  </div><!-- /tab-battle -->


  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- TAB: COMBAT                                                -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <div id="tab-combat" class="tab-panel">

    <div class="rule-section">
      <div class="section-divider"><span>Ranged Combat Sequence</span></div>
      <ol class="steps-list">
        <li><strong>Choose Targets</strong> — Select targets for all weapons before resolving. At least one model visible and in range. Can't target units in melee.</li>
        <li><strong>Resolve Attacks</strong> — If multiple targets, resolve all attacks vs one unit before moving to next.</li>
        <li><strong>Hit Rolls</strong> — Roll to hit vs model's BS. Roll of 6 always succeeds.</li>
        <li><strong>Wound Rolls</strong> — Roll based on weapon Strength vs target Toughness.</li>
        <li><strong>Saving Throws</strong> — Roll save, subtract weapon AP. Ward save unaffected by AP. If the required save would be worse than 6+ and the model has no Ward save (or its Ward save is also worse than 6+), skip the roll and apply the damage.</li>
        <li><strong>Damage</strong> — Failed save = damage equal to weapon profile. When damage ≥ Wounds, model removed. Damage doesn't carry over. Removing casualties <strong>ends immediately</strong> once no enemy model is left within LOS or within the weapon's range.</li>
        <li><strong>Leadership Test</strong> — If unit drops below half starting strength, pass Ld test or receive 2 Battleshock tokens.</li>
      </ol>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Line of Sight</span></div>
      <p>At least one model in the target unit must be visible to the attacker. What actually counts as "the model" differs between creatures and vehicles.</p>
      <div class="diagram-box">
        <svg class="diagram-svg" viewBox="0 0 640 190" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Line of sight diagram: for creatures only the body counts and gear is ignored; for vehicles the whole hull and mounted weapons count.">
          <text x="160" y="18" text-anchor="middle" class="dg-title">CREATURES</text>
          <text x="480" y="18" text-anchor="middle" class="dg-title">VEHICLES</text>
          <line x1="320" y1="14" x2="320" y2="176" stroke="var(--c40k-steel)" stroke-width="1" stroke-dasharray="3,3" opacity="0.4"/>

          <!-- Creature: dashed ignored wings, then solid body on top -->
          <path d="M 108 60 Q 88 50 78 62 Q 92 78 112 82 Z" fill="none" stroke="var(--c40k-steel)" stroke-width="1.5" stroke-dasharray="3,2" opacity="0.55"/>
          <path d="M 212 60 Q 232 50 242 62 Q 228 78 208 82 Z" fill="none" stroke="var(--c40k-steel)" stroke-width="1.5" stroke-dasharray="3,2" opacity="0.55"/>
          <rect x="126" y="46" width="60" height="42" rx="8" fill="none" stroke="var(--c40k-steel)" stroke-width="1.5" stroke-dasharray="3,2" opacity="0.55"/>
          <circle cx="160" cy="38" r="13" fill="var(--c40k-steel)"/>
          <rect x="141" y="52" width="38" height="52" rx="8" fill="var(--c40k-steel)"/>
          <rect x="125" y="58" width="13" height="42" rx="6" fill="var(--c40k-steel)"/>
          <rect x="182" y="58" width="13" height="42" rx="6" fill="var(--c40k-steel)"/>
          <rect x="143" y="102" width="14" height="42" rx="6" fill="var(--c40k-steel)"/>
          <rect x="163" y="102" width="14" height="42" rx="6" fill="var(--c40k-steel)"/>
          <text x="160" y="160" text-anchor="middle" class="dg-caption-b">Body counts</text>
          <text x="160" y="172" text-anchor="middle" class="dg-caption">head · torso · arms · legs</text>
          <text x="160" y="184" text-anchor="middle" class="dg-caption">gear (packs, wings) ignored — treated as air</text>

          <!-- Vehicle: solid hull + turret + weapon, dashed ignored fittings -->
          <circle cx="428" cy="86" r="6" fill="none" stroke="var(--c40k-steel)" stroke-width="1.5" stroke-dasharray="2,2" opacity="0.55"/>
          <line x1="530" y1="90" x2="542" y2="66" stroke="var(--c40k-steel)" stroke-width="1.5" stroke-dasharray="2,2" opacity="0.55"/>
          <rect x="432" y="88" width="96" height="52" rx="7" fill="var(--c40k-steel)"/>
          <rect x="464" y="66" width="32" height="28" rx="4" fill="var(--c40k-steel)"/>
          <rect x="476" y="46" width="6" height="24" fill="var(--c40k-steel)"/>
          <text x="480" y="160" text-anchor="middle" class="dg-caption-b">Hull + weapons count</text>
          <text x="480" y="172" text-anchor="middle" class="dg-caption">full hull/silhouette, incl. mounted guns</text>
          <text x="480" y="184" text-anchor="middle" class="dg-caption">fittings (searchlight, antenna, banners) ignored</text>
        </svg>
      </div>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Strength vs. Toughness</span></div>
      <table class="ref-table">
        <thead><tr><th>Condition</th><th>To Wound Roll</th></tr></thead>
        <tbody>
          <tr><td>S ≥ 2×T</td><td class="roll-good">2+</td></tr>
          <tr><td>S &gt; T</td><td class="roll-good">3+</td></tr>
          <tr><td>S = T</td><td>4+</td></tr>
          <tr><td>S &lt; T</td><td class="roll-bad">5+</td></tr>
          <tr><td>S ≤ ½T</td><td class="roll-bad">6+</td></tr>
        </tbody>
      </table>
      <p class="note">Strength "D": wound roll of 2+ always succeeds; vehicles with AV 10 or less are automatically penetrated; against all other vehicles an armor penetration roll of 2+ is always a penetrating hit. If the penetration roll was high enough to actually pen (treat Strength: D as Strength: 10), you also cause an automatic Critical Hit.</p>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Melee Combat Sequence</span></div>
      <ol class="steps-list">
        <li><strong>Defender Movement</strong> — Defender moves up to 6″ to place models in base contact. Characters take priority.</li>
        <li><strong>Initiative Order</strong> — Models act from highest to lowest Initiative. Same Initiative = simultaneous.</li>
        <li><strong>Engagement Range</strong> — Base contact OR within 1″ of a friendly model in base contact. Can fight one level up/down.</li>
        <li><strong>Resolve Attacks</strong> — Distribute A stat freely among melee weapons. Roll vs WS. Roll of 6 always hits.</li>
        <li><strong>Combat Result</strong> — Only scored if enemy units are still in base contact; otherwise the remaining side automatically wins. Score: +1 for more remaining wounds, +1 per wound caused (Creatures), +1 per penetrating hit (Vehicles). Winner = more points.</li>
        <li><strong>Losing Combat</strong> — Loser takes Ld test with penalty = result difference. Fail: 2 Battleshock tokens (flee).</li>
        <li><strong>Pursuit</strong> — Winner may pursue fleeing units: roll D6+highest I. Match or exceed fleeing unit's roll to catch (+1 auto hit per model, −1 Battleshock token from fleeing unit).</li>
      </ol>
      <p class="note">*Vehicle remaining HP count as 5 Wounds each for combat scoring.</p>
      <div class="diagram-box">
        <img class="diagram-svg" src="/diagrams/charge-move.svg" loading="lazy" decoding="async"
             alt="Charge move: a normal move up to the model's Movement, capped at 12 inches, then a further charge move of up to 6 inches in a straight line into base contact." />
        <div class="diagram-legend"><span><strong>Normal move</strong> — up to Movement (max 12&Prime;)</span><span><strong>Charge move</strong> — a further 6&Prime;, straight line, into base contact</span></div>
      </div>
      <div class="diagram-box">
        <img class="diagram-svg" src="/diagrams/engagement-range.svg" loading="lazy" decoding="async"
             alt="Engagement range: a model in base contact with the enemy fights, and so does a friendly model within 1 inch of that model." />
        <div class="diagram-legend"><span>In base contact — fighting</span><span>A model within 1&Prime; of one in base contact joins the fight</span></div>
      </div>
      <div class="diagram-box">
        <img class="diagram-svg" src="/diagrams/melee-participation.svg" loading="lazy" decoding="async"
             alt="Melee participation: models in base contact with the enemy fight, and friendly models within 1 inch of one of them join in; models further back do not." />
        <div class="diagram-legend"><span>In base contact — fights</span><span>Within <strong>1&Prime;</strong> of a model in base contact — joins in</span><span>Anyone further back does not fight</span></div>
      </div>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Cover</span></div>
      <div class="cover-grid">
        <div class="cover-card">
          <div class="cover-title">Light Cover</div>
          <ul><li>+1 Armour Save</li><li>−1 hit to ranged attackers</li><li>−1 AT to incoming ranged</li><li>Example: sandbag barricades</li></ul>
        </div>
        <div class="cover-card">
          <div class="cover-title">Heavy Cover</div>
          <ul><li>+2 Armour Save</li><li>−1 hit to ranged attackers</li><li>−1 AT to incoming ranged</li><li>Example: bunkers</li></ul>
        </div>
        <div class="cover-card">
          <div class="cover-title">Obscuring Terrain</div>
          <ul><li>Cover if line passes through terrain ≥ ½ height &amp; width</li><li>−1 hit for attacker</li><li>No AP penalty or armour save bonus (not treated as cover)</li></ul>
        </div>
      </div>
      <p class="note">Cover requires ≥50% of models/bases to be in it. If both sides benefit from the same terrain, neither gets the bonus. Units in cover that are charged always get Hold Your Ground.</p>
      <div class="diagram-box">
        <img class="diagram-svg" src="/diagrams/obstacle-cover.svg" loading="lazy" decoding="async"
             alt="Obstacle cover: a model within 3 inches of an obstacle benefits from cover when a straight line from the attacker crosses that obstacle." />
        <div class="diagram-legend"><span>Within <strong>3&Prime;</strong> of the obstacle</span><span>Line base-centre &rarr; base-centre crosses it</span><span>Obstacle at least &frac12; the unit&rsquo;s height &amp; width</span></div>
      </div>
      <div class="diagram-box">
        <img class="diagram-svg" src="/diagrams/terrain-zone.svg" loading="lazy" decoding="async"
             alt="Terrain zone: a unit benefits from cover while inside the zone." />
        <div class="diagram-legend"><span>Inside a terrain zone the unit always benefits from cover</span><span>Targeting an enemy in the <em>same</em> zone grants no cover</span></div>
      </div>
      <p class="note">Obstacle: needs to be within 3″ of it too. Obscuring terrain/unit: no distance limit, but grants only −1 to hit — no AP change or save bonus.</p>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Terrain Types</span></div>
      <div class="rule-grid">
        <div class="rule-card">
          <div class="rule-name">Normal Terrain</div>
          <p>No movement restrictions.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Difficult Terrain</div>
          <p>Movement penalty: M3″=−1″ / M6″=−2″ / M12″=−4″ / M24″=−8″ (or 33% rounded up). Penalty applies once per activation. Alt: move full speed but treat as dangerous.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Dangerous Terrain</div>
          <p>Each model rolls 1D6; each 1 = wound (no saves). Vehicles suffer Engine Damage instead. Test once per activation.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Impassable Terrain</div>
          <p>Cannot pass through. Anti-Grav and Jump Pack models may move over it. Cannot end movement on it.</p>
        </div>
      </div>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Melee over Terrain</span></div>
      <p>Two units separated by a terrain piece — a sandbag barrier, a wall — can still fight each other, but only if <strong>all three</strong> of these are true:</p>
      <ul class="plain-list">
        <li>At least one model among the two units is <strong>33% taller</strong> than the terrain piece between them.</li>
        <li>The terrain piece separates the two units by <strong>no more than 1&Prime;</strong>.</li>
        <li>The terrain piece has <strong>no roof at all</strong>, or a crevice/window between them at least <strong>0.5&Prime;</strong> tall and wide.</li>
      </ul>
      <p class="note">Miss any one of the three and there is no melee over that terrain piece.</p>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Vehicle Damage Chart</span></div>
      <p class="note">Against a vehicle you do not follow the normal rules for wounding models — you resolve an <strong>Armor penetration roll</strong> instead, and consult this chart on a penetrating hit.</p>
      <table class="ref-table">
        <thead><tr><th>D6</th><th>Result</th><th>Effect</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>—</td><td>Nothing happens.</td></tr>
          <tr><td>2</td><td class="result-label">Crew Shaken</td><td>−1 to hit, −50% movement until end of next activation. Not cumulative.</td></tr>
          <tr><td>3</td><td class="result-label">Engine Damage</td><td>Movement reduced by ⅓ permanently. Fully immobilised = can't move at all (Advance and Charge movement included), no melee lock. If can't reduce further → lose 1 HP.</td></tr>
          <tr><td>4</td><td class="result-label">Weapon Damage</td><td>Owner chooses a weapon — permanently destroyed. Can spend 1 HP instead of losing last weapon.</td></tr>
          <tr><td>5</td><td class="result-label">Structural Damage</td><td>Lose 1 Hull Point.</td></tr>
          <tr><td>6</td><td class="result-label result-crit">Critical Damage</td><td>Attacker picks: Engine Damage, Weapon Damage, or Structural Damage.</td></tr>
        </tbody>
      </table>
      <p class="note">Glancing Hit: roll chart × AT value, apply only highest result (no 6s). Penetrating Hit: roll × AT value, apply ALL results.</p>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Vehicle Destruction</span></div>
      <p>A vehicle is destroyed when it loses its last Hull Point, and <em>how</em> it lost it decides what happens next.</p>
      <div class="rule-grid">
        <div class="rule-card">
          <div class="rule-name">Wreckage</div>
          <p>Last Hull Point lost to Engine, Weapon or Structural Damage. The model <strong>stays on the table as difficult terrain</strong>. Passengers disembark within 3&Prime; and each must pass a Leadership test or take a Battleshock token.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Explosion</div>
          <p>Last Hull Point lost to Critical Damage. Every model within <strong>D6&Prime;</strong> takes a S5 / AP 0 / D1 hit. Passengers take those wounds <strong>automatically</strong> and get a Battleshock token. Casualties count towards the combat result in melee. Survivors disembark within 3&Prime; and act on their activation according to how far the vehicle had moved.</p>
        </div>
        <div class="rule-card">
          <div class="rule-name">Emergency Disembarkation</div>
          <p>If passengers cannot be placed — terrain or enemies in the way — they disembark within <strong>6&Prime;</strong> instead but count as activated for the rest of the round. Models that still cannot be placed are removed from play.</p>
        </div>
      </div>
      <p class="note">Flyers: passengers may only disembark in Hover mode, and an exploding flyer deals them <strong>double</strong> the automatic wounds.</p>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Mixed Units</span></div>
      <ul class="plain-list">
        <li><strong>Mixed Armour Save:</strong> Use the save value that occurs most. Tie = controlling player chooses. Casualties from failed saves must come from models matching that save first.</li>
        <li><strong>Mixed Toughness:</strong> Use the T value that occurs most. Tie = controlling player chooses.</li>
        <li><strong>Mixed Defensive Rules:</strong> Use the special rule (or lack of one) that occurs most.</li>
        <li><strong>Characters:</strong> Cannot voluntarily take wounds for the unit. Always use their own armour/invul save.</li>
      </ul>
    </div>

    <div class="rule-section reveal">
      <div class="section-divider"><span>Suppressive Fire</span></div>
      <p>A unit scoring 6+ ranged hits in its activation forces the target to take a Ld test. For every additional 6 hits: cumulative −1 penalty. Fail → 1 Battleshock token (if they had none). If the target would also have to test for dropping below half Starting Strength at the same time, it rolls only for Suppressive Fire — and a failure gives 2 tokens even if it already had one.</p>
    </div>

  </div><!-- /tab-combat -->


